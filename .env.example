# ==============================================================================
# Thulir Infra Environment Variables Template
# Copy this file to `.env` (or `.env.local`) and replace values with your credentials.
# ==============================================================================

# Resend API Key (Required for sending enquiry emails)
# Obtain from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Resend Sender Email (Optional)
# Defaults to "Thulir Infra <onboarding@resend.dev>" if not set.
# When using a verified domain on Resend, configure your sender address here:
# e.g. "Thulir Infra <enquiries@thulirinfra.com>"
RESEND_FROM_EMAIL="Thulir Infra <onboarding@resend.dev>"
